Options -Indexes
DirectoryIndex index.php

<FilesMatch "^\.(?!well-known/)">
    Require all denied
</FilesMatch>
<FilesMatch "^(README\.md|LICENSE|composer\.(json|lock)|phpunit\.xml(\.dist)?)$">
    Require all denied
</FilesMatch>
<FilesMatch "\.(sql|log|ini|env|bak|old|orig|swp|dist)$">
    Require all denied
</FilesMatch>
